APP_ENV=development
# Empty = in-memory stores (no persistence). Fixtures still come only from the API.
DATABASE_URL=postgresql+psycopg://edgeboard:edgeboard@localhost:5432/edgeboard
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=60
# Fixtures, teams, statistics, injuries, lineups (required: without it nothing is shown)
FOOTBALL_PROVIDER=api_football
API_FOOTBALL_KEY=
# Odds: api_football (looked up by fixture id, recommended) | the_odds_api (exact team-name/alias match)
ODDS_PROVIDER=api_football
THE_ODDS_API_KEY=
# Defines "today" for the slate and the kickoff-date check
APP_TIMEZONE=Africa/Lagos
# Optional: Claude explains verified data in the AI analyst; without it the rule-based explainer is used
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
COMPETITION_WHITELIST=epl,laliga,seriea,bundesliga,ligue1,eredivisie,primeira,ucl,uel,uecl,facup,eflcup,copadelrey,coppaitalia,dfbpokal,coupedefrance,knvbcup,tacadeportugal,uefasupercup,clubworldcup
